goto "SectionBrew617"
[Restart]
print "@ 243 Restarted"
[SectionBrew617]
wait "gblV_Brew_Status" value == 617
show workspace "B1 Brewery"
vV_Vessel_WORT_From = "gblV_Vessel_From" value
if vV_Vessel_WORT_From == 4
vS_Vessel_WORT_From = "Brew Kettle"
endif
if vV_Vessel_WORT_From == 5
