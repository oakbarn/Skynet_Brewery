			"gblS_Brewery_Bottom_4" visibility = vS_Save_Visibility_Bottom_4 
		endif

"gblV_Set_BackGround_Middle_Time" value = vV_Save_Inspector 
"insp_Pix_ArrowAllSwitch_B1" background = vV_Save_Arrow_Background 
