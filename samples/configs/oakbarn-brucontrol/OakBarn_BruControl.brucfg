wait "tmBottomRight_B1" value &lt;= 00:00:00
stop "tmBottomRight_B1"
"tmBottomRight_B1" visibility = hidden
"insp_1_LeftMiddle_B1" visibility = hidden
//............................................................
goto "ReStart"
