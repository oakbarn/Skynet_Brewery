vSMsg_End = "  The Fermentors must be Cleaned, Sanitized, Drained &amp;&amp; ALL Fermentor Valves Closed. Ready to accept WORT.  The Status must be 5: READY!"
"gblS_Brewery_Bottom_3" value = vSMsg_End
vB_Skip = true
endif
if vV_Status == 0
	if vB_Skip == true
	goto "Skip_Early_A_2"
	endif
	vSMsg1 = ":  The Status = Unknown. Find out what the Status is and Set It. " 
	vSMsg_End = "If left as Unknown, the Fermentor will NOT be reviewed later. "
