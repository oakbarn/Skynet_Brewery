//Continues to Set Brew Day with General Strike Status.
//................................
// Set Testing
[Set_Testing]
new bool vB_Testing
vB_Testing = "sw_Status_Testing" state
start "inscpt_scrClearB1_Brewery"
sleep 100
wait "sw_Running_Clear_B1" state == false
