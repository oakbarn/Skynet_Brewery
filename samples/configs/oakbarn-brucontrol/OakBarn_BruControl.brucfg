	"gblS_Bottom_Text" value  = "1: Disconnect Tap Water (In &amp;&amp; OUT)\n2: Connect ICE Bath Pump Outlet Hose\n3: Connect Return to ICE Bath\n4: Place Pump in Ice Bath\n5: Turn on ICE Bath Outlet Pump" 
	"gblS_swAllSwitch_Label_Text" value = "ICE Bath Source?"
goto "Cooling_Message"
//
	if vVCooling == 4
