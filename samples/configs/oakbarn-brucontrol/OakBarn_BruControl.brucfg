[Skip_Restart]
[SectionBrew618]
[SectionBrew619]
"gblV_Brew_Status" value = 620
[SectionBrew620]
wait "gblV_Brew_Status" value == 620
print 268
 vSMsg = "1: " 
 vSMsg1 = vS_Ferment_1
 vSMsg = vSMsg + vSMsg1
 vSMsg1 = "\n"
 vSMsg = vSMsg + vSMsg1
 vSMsg1 = "2: " 
