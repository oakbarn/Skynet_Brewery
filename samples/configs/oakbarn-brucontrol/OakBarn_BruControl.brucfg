// B1 Brewery Left visibility ......................
"gblS_BrewName_B1" value = "gblS_BeerName_R1" value
"gblS_Brewery_Top_1" visibility = hidden
"gblS_Brewery_Top_2" visibility = hidden
"gblSReportLabel_B1" visibility = hidden
