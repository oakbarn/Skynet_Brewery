	vB_BackManifold_Left_On = true
	goto "From_External"
	endif
	if vB_From_Big_Mac == true
	vB_BackManifold_Left_On = true
	goto "From_Big_Mac"
	endif
	if "sw_Flow_From_Radiator" state == true
	vB_White_Pump = false
