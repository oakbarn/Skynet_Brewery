"gblV_Hop1_Group_R1" visibility = hidden 
goto "HopSwMessage"
endif
if "sw_Flow_SOB_Hop1" state == true 
print "Start of Boil"
"sw_Use_Hop1_Batch" state = true
"gblS_Hop1_R1" displayname = "Hop #1 - Start of Boil"
