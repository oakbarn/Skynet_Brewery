goto "EOBAroma"
endif
if vVGroup_EoB_Status == 1200
goto "EOBRocket"
endif
if vVGroup_EoB_Status == 6200
goto "EOBRocket"
endif
if vVGroup_EoB_Status == 1300
goto "EOBBoth"
endif
if vVGroup_EoB_Status == 6300
goto "EOBBoth"
endif
//Aroma Only
[EOBAroma]
"gblS_HopMessage_ALARM" displayname = "Drop Aroma Whirlpool Hops"
