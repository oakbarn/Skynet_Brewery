"alm_Hops_3_ALARM" active = true
"alm_Hops_3_ALARM" visibility = visible
"gblS_HopMessage_ALARM" visibility = visible
wait "alm_Hops_3_ALARM" active == false
"gblVStartBrew" value = 101
goto EOB_Hop_End
//Hop Rocket Only
[EOBRocket]
