	vB_BrewKettleTangental_On = false
	goto "From_Mash_Tun"
	endif
	if "sw_Flow_From_Brew_Kettle" state == true
vB_LittleMacIsolation_On = true
	vB_BackManifold_Left_On = false
	goto "From_Brew_Kettle"
	endif
endif
