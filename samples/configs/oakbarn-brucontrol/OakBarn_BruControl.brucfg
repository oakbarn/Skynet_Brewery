		//
		if vVHop5_Drop_Min &gt; vVHop6_Drop_Min
		"gblV_Hop6_Group_R1" value = "gblV_Hop5_Group_R1" value + 1
		endif
		if vVHop5_Drop_Min &lt; vVHop6_Drop_Min
		"gblV_Hop6_Group_R1" value = 919
