"gblVReport_B1" value = -1
"gblVReport_B1" precision = 0
"gblS_swAllSwitch_Label_Text" value = ""
//........................................
//Inspector_Red
"gblV_Set_BackGround_Middle_Time" value = 4
start "inscpt_scrSet_Middle_Backgrounds"
//........................................
//BackGround
"gblS_Brewery_Top_2" background = 1 
//Visibility
