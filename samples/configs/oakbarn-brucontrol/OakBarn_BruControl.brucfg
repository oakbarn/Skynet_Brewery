	"MB_36_do_RedPump_B1" state = false
	"MB_35_do_YellowPump_B1" state = false
	goto "SetValves"
	endif
endif
if  "gblVReport_B1" value &gt; 2
goto "1or2Only"
endif
goto "Loop_Cooling"
