vSMsg = vSMsg + vSMsg1
vSMsg1 = " is "
vSMsg = vSMsg + vSMsg1
vSMsg1 = vVRate_Calc
vSMsg = vSMsg + vSMsg1
vSMsg1 = " SPG.  The Original Rate used to calculate was "
vSMsg = vSMsg + vSMsg1
vSMsg1 = vVRate_Orginal
vSMsg = vSMsg + vSMsg1
vSMsg1 = " SPG and there NO significant difference."
vSMsg = vSMsg + vSMsg1
vB_Rate_Good = true
"tmBottomRight_B1" value = 00:00:04
goto "Rate_Good_4000"
endif
