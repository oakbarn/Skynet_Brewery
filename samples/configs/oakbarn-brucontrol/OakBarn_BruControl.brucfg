sleep 101
endif
wait "sw_Running_ValveOperation" state == false
endif
[End_sub_scrManifold_Choice]
"gblS_Inter_Script" value = "ended: sub_scrManifold_Choice"
if vB_Testing == true
sleep 101
endif
clear
"sw_Running_Manifold_Choice" state = false
stop "sub_scrManifold_Choice"

