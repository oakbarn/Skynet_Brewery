"gblV_Strike_Vessel_Max_Volume_2" value = 0
"sw_Flow_2_Vessels_Strike" state = false
"glbS_Isolation_Valve" value = ""
"gblV_Number_Strike_Vessels" value = 1
"gblV_Strike_Vessel_1" value = 0
"gblV_Strike_Vessel_2" value = 0
