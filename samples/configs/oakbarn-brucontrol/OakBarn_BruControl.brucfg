"gblT_SetTimer_Water" value = vS_TTL_Time_W
print "@175 Transfer time = "
print vS_TTL_Time_W
"gblV_Sub4_Status" value = 4006
[SectionBrewSub4_4006]
wait "gblV_Sub4_Status" value == 4006
//......................................
//......................................
//Return from sub_3_scrCalculateSPG to start Pumps
//......................................
//......................................
