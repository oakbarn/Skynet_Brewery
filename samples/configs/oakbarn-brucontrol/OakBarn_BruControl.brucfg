goto "LoopDryHopEnd"
[EnderDryHop]
"gblV_Brew_Status" value = 10
if vB_Testing == true
"gblS_Inter_Script" value = "ended: Hops_20_Hop_Text_DryHop"
sleep 4001
endif
clear
"gblVScriptFlow" value = 21
stop "Hops_20_Hop_Text_DryHop"</Script>
