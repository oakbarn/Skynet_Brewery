// Set Testing
[Set_Testing]
new bool vB_Testing
vB_Testing = "sw_Status_Testing" state
start "inscpt_scrClearB1_Brewery"
sleep 100
wait "sw_Running_Clear_B1" state == false
start "inscpt_scrBasicStart"
//.................................
 if vB_Testing == true
"gblS_Script_Started" value = "Started: scrBrew0_4_Strike_Tree" 
