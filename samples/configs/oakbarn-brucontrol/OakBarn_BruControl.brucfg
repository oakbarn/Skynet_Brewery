"gblV_Delay_Seconds" value = 5
start "inscpt_scrShortDelay"
sleep 100
wait "sw_Running_Short_Delay_Time" state == false
//........................................
show workspace "Batch1 Hops"
goto "SectionBrew5"
[SectionBrew5]
wait "gblV_Brew_Status" value == 5
