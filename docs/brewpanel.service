# systemd service for Raspberry Pi / Linux
# Copy to /etc/systemd/system/brewpanel.service, change User and WorkingDirectory, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now brewpanel
[Unit]
Description=Skynet Brew Panel
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/brewpanel
ExecStart=/usr/bin/node --no-warnings server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
